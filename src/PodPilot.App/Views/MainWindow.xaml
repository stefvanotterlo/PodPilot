<!--
    Hoofdvenster: navigatie links, tabbladen rechts.
      Overzicht    – grote versie van de pop-up (afbeelding, batterijen, verbinden)
      AirPods      – automatisch verbinden, oordetectie, welke AirPods
      Instellingen – algemeen, meldingen, thema (hoofdvenster en pop-up apart)
      Over         – versie, diagnoselog
    Een wijziging werkt meteen en wordt direct opgeslagen; er is geen "Opslaan"-knop
    (net als in de Windows-instellingen). DataContext = StatusViewModel van de app.
-->
<Window x:Class="PodPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodPilot"
        Width="1000" Height="640" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Titel + uitleg links in een instellingenregel. -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,20" />
        </Style>
        <!-- Een tabblad: scrollt als het niet past, inhoud niet breder dan nodig. -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Grote tegel op het Overzicht: icoon, naam, percentage, balk, resterende tijd. -->
        <DataTemplate x:Key="BigTile">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource WindowBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="18,22" Margin="8,0"
                    ToolTip="{Binding ToolTipText}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="76" Height="76" HorizontalAlignment="Center">
                        <Path x:Name="Icon" Data="{StaticResource BudGeometry}" Fill="{DynamicResource IconFill}"
                              Stretch="Uniform" Margin="6" RenderTransformOrigin="0.5,0.5" />
                        <!-- Blauwe stip: oordop zit in het oor. -->
                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                Visibility="{Binding IsInEar, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <StackPanel x:Name="PercentRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Path Data="{StaticResource BoltGeometry}" Fill="{DynamicResource AccentBrush}"
                              Stretch="Uniform" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PercentText}" FontSize="32" FontWeight="SemiBold" />
                    </StackPanel>

                    <ProgressBar x:Name="Bar" Style="{StaticResource BatteryBar}" Width="120" Height="8" Margin="0,10,0,0"
                                 Value="{Binding Value, Mode=OneWay}" />

                    <TextBlock Text="{Binding RemainingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               ToolTip="Schatting op basis van je eerdere luistersessies"
                               Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Zelfde richting als in de pop-up: links = gespiegeld. -->
                <DataTrigger Binding="{Binding Kind}" Value="LeftBud">
                    <Setter TargetName="Icon" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="-1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Case">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource CaseGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Headphones">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource HeadphonesGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Medium">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource MediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Low">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource LowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Unknown">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="PercentRow" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigatie ===== -->
        <Border Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="{StaticResource BudsInCaseIllustration}" Width="30" Height="28" />
                    <TextBlock Text="PodPilot" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- E80F = huis, E7F6 = koptelefoon, E713 = tandwiel, E946 = info -->
                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                 Content="Overzicht" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavAirPods" Style="{StaticResource NavButton}" Tag="&#xE7F6;"
                                 Content="AirPods" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="Instellingen" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="&#xE946;"
                                 Content="Over" Checked="OnNavChecked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Overzicht ===== -->
        <ScrollViewer x:Name="OverviewPage" Grid.Column="1" Style="{StaticResource Page}" Visibility="Visible">
            <Grid Margin="36,30,36,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kop: naam en status links, verbinden rechts. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="2,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontSize="28" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Verbindingsstatus als "pil": groene stip als de audio met deze pc verbonden is. -->
                        <Border Background="{DynamicResource ButtonBackground}" CornerRadius="15" Padding="12,6"
                                VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource HighBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ConnectButtonText}"
                                IsEnabled="{Binding CanToggleConnection}" Click="OnConnectClick" />
                    </StackPanel>
                </Grid>

                <!-- Afbeelding links, drie tegels rechts. -->
                <Grid Grid.Row="1" Margin="0,26,0,0" Height="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Afbeelding op een zachte vlak in de accentkleur. -->
                    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                            Background="{DynamicResource AccentSubtleBrush}">
                        <Image Source="{StaticResource BudsInCaseIllustration}" Width="200" Height="183"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Components}" ItemTemplate="{StaticResource BigTile}"
                                  Margin="8,0,-8,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Snelle instellingen: dezelfde schakelaars als op het tabblad AirPods. -->
                <TextBlock Grid.Row="2" Text="Snelle instellingen" Style="{StaticResource SectionTitle}" Margin="2,24,0,0" />
                <UniformGrid Grid.Row="2" Rows="1" Margin="-6,52,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Case open" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="Automatisch verbinden" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickConnectLidToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Verbinden als de case opengaat" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Oordop in" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="Automatisch verbinden" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickConnectEarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Verbinden als je ze indoet" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Oordop uit" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="Media pauzeren" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickPauseToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Pauzeren als een oordop uitgaat" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <!-- ===== AirPods ===== -->
        <ScrollViewer x:Name="AirPodsPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="AirPods" Style="{StaticResource PageTitle}" />

                <TextBlock Text="Automatisch verbinden" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Verbinden als de case opengaat" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Haalt de audio naar deze pc, ook als de AirPods met je telefoon verbonden waren." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectLidToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Verbinden als de case opengaat" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Verbinden als je ze indoet" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Zodra de eerste oordop in je oor gaat. Na zelf verbreken pas weer als de case dicht is geweest." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectEarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Verbinden als je ze indoet" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Oordetectie" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Pauzeren als een oordop uitgaat" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Alleen als de AirPods met deze pc verbonden zijn." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPauseToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Pauzeren als een oordop uitgaat" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="AutoResumeRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Hervatten als hij weer in gaat" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Binnen 5 minuten, en alleen wat PodPilot zelf heeft gepauzeerd." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoResumeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Hervatten als hij weer in gaat" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Welke gepairde AirPods gebruikt PodPilot?" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="DevicePanel" Margin="0,12,0,6" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Instellingen ===== -->
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Instellingen" Style="{StaticResource PageTitle}" />

                <TextBlock Text="Algemeen" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Starten met Windows" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="PodPilot start bij het aanmelden in het systeemvak." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Starten met Windows" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Pop-up als de case opengaat" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Toont de batterijen als je de case naast de pc opent." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPopupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Pop-up als de case opengaat" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Sneltoets voor de pop-up" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Toont of verbergt de pop-up, ook als PodPilot niet op de voorgrond staat." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="HotkeyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Sneltoets voor de pop-up" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="HotkeyRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Toetscombinatie" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}"
                                           Text="Klik op de knop en druk een nieuwe combinatie." />
                            </StackPanel>
                            <!-- Opnemen: klik, druk de combinatie. Esc = annuleren. -->
                            <Button x:Name="HotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" Click="OnHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown"
                                    LostKeyboardFocus="OnHotkeyLostFocus" AutomationProperties.Name="Toetscombinatie voor de pop-up" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Meldingen" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Melding bij lage batterij" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Eén melding per oordop zodra die op of onder de drempel komt." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="NotifyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Melding bij lage batterij" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel x:Name="ThresholdSection" Margin="0,12">
                            <TextBlock Text="Drempel" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="ThresholdPanel" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Thema" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="ThemeSection" Margin="0,12">
                            <TextBlock Text="Hoofdvenster" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="ThemePanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel x:Name="PopupThemeSection" Margin="0,12">
                            <TextBlock Text="Pop-up bij het systeemvak" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="PopupThemePanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <!-- Eigen achtergrondkleur (geldt voor hoofdvenster én pop-up). -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Eigen achtergrondkleur" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Voor het hoofdvenster en de pop-up. De kleur bepaalt ook of de tekst licht of donker is." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="CustomBackgroundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Eigen achtergrondkleur" />
                        </Grid>
                        <StackPanel x:Name="CustomBackgroundRow" Orientation="Horizontal" Margin="0,0,0,14">
                            <WrapPanel x:Name="BackgroundSwatches" VerticalAlignment="Center" />
                            <TextBox x:Name="BackgroundHex" Style="{StaticResource HexBox}" Margin="6,0,0,0"
                                     AutomationProperties.Name="Achtergrondkleur als hexcode" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <!-- Eigen accentkleur. -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Eigen accentkleur" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Voor schakelaars, knoppen en het actieve tabblad, in plaats van de accentkleur van Windows." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="CustomAccentToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Eigen accentkleur" />
                        </Grid>
                        <StackPanel x:Name="CustomAccentRow" Orientation="Horizontal" Margin="0,0,0,14">
                            <WrapPanel x:Name="AccentSwatches" VerticalAlignment="Center" />
                            <TextBox x:Name="AccentHex" Style="{StaticResource HexBox}" Margin="6,0,0,0"
                                     AutomationProperties.Name="Accentkleur als hexcode" />
                        </StackPanel>
                        <TextBlock x:Name="ColorHint" Style="{StaticResource RowHint}" Margin="0,-6,0,12"
                                   Foreground="{DynamicResource LowBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Over ===== -->
        <ScrollViewer x:Name="AboutPage" Grid.Column="1" Style="{StaticResource Page}">
            <!-- Verdwijnt als de verborgen achtergrond aangaat, zodat je alleen de foto ziet. -->
            <StackPanel x:Name="AboutContent" Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Over PodPilot" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource BudsInCaseIllustration}" Width="72" Height="66" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="PodPilot" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowHint}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,0"
                                       Text="Toont de batterij van je AirPods en regelt de verbinding met deze pc. Geen account, geen internet: alles blijft op deze computer." />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource PillButton}" Content="Diagnoselog openen" Margin="0,0,8,8"
                                        Click="OnOpenLogClick" />
                                <Button Style="{StaticResource PillButton}" Content="Map met instellingen" Margin="0,0,8,8"
                                        Click="OnOpenSettingsFolderClick" />
                                <Button Style="{StaticResource PillButton}" Content="Bluetooth-instellingen" Margin="0,0,8,8"
                                        Click="OnBluetoothSettingsClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
