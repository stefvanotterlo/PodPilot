<!--
    Hoofdvenster: navigatie links, tabbladen rechts.
      Overzicht    – grote versie van de pop-up (afbeelding, batterijen, verbinden)
      AirPods      – automatisch verbinden, oordetectie, welke AirPods
      Instellingen – algemeen, meldingen, thema (hoofdvenster en pop-up apart)
      Over         – versie, diagnoselog
    Een wijziging werkt meteen en wordt direct opgeslagen; er is geen "Opslaan"-knop
    (net als in de Windows-instellingen). DataContext = StatusViewModel van de app.
-->
<Window x:Class="PodPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PodPilot.App.Services"
        Title="{l:T 'PodPilot'}"
        Width="1000" Height="740" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Titel + uitleg links in een instellingenregel. -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,20" />
        </Style>
        <!-- Een tabblad: scrollt als het niet past, inhoud niet breder dan nodig. -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Grote tegel op het Overzicht: icoon, naam, percentage, balk, resterende tijd. -->
        <DataTemplate x:Key="BigTile">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource WindowBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="18,22" Margin="8,0"
                    ToolTip="{Binding ToolTipText}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="76" Height="76" HorizontalAlignment="Center">
                        <!-- Foto van de oordop/case; de getekende Path alleen voor koptelefoons. -->
                        <Image x:Name="Photo" Source="/PodPilot;component/Assets/bud-right.png" Stretch="Uniform"
                               Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Path x:Name="Icon" Data="{StaticResource HeadphonesGeometry}" Fill="{DynamicResource IconFill}"
                              Stretch="Uniform" Margin="6" Visibility="Collapsed" />
                        <!-- Blauwe stip: oordop zit in het oor. -->
                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                Visibility="{Binding IsInEar, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <StackPanel x:Name="PercentRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Path Data="{StaticResource BoltGeometry}" Fill="{DynamicResource AccentBrush}"
                              Stretch="Uniform" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PercentText}" FontSize="32" FontWeight="SemiBold" />
                    </StackPanel>

                    <ProgressBar x:Name="Bar" Style="{StaticResource BatteryBar}" Width="120" Height="8" Margin="0,10,0,0"
                                 Value="{Binding Value, Mode=OneWay}" />

                    <TextBlock Text="{Binding RemainingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               ToolTip="{Binding NoteToolTip}"
                               Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="LeftBud">
                    <Setter TargetName="Photo" Property="Source" Value="/PodPilot;component/Assets/bud-left.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Case">
                    <Setter TargetName="Photo" Property="Source" Value="/PodPilot;component/Assets/case-closed.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Headphones">
                    <Setter TargetName="Photo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Medium">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource MediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Low">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource LowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Unknown">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Photo" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="PercentRow" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigatie ===== -->
        <Border Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="{StaticResource BudsInCaseIllustration}" Width="30" Height="28" />
                    <TextBlock Text="{l:T 'PodPilot'}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- E80F = huis, E7F6 = koptelefoon, E713 = tandwiel, E765 = toetsenbord, E946 = info -->
                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                 Content="{l:T 'Overzicht'}" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavAirPods" Style="{StaticResource NavButton}" Tag="&#xE7F6;"
                                 Content="{l:T 'AirPods'}" Checked="OnNavChecked" />
                    <!-- E772 = apparaten -->
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" Tag="&#xE772;"
                                 Content="{l:T 'Apparaten'}" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="{l:T 'Instellingen'}" Checked="OnNavChecked" />
                    <!-- E765 = toetsenbord -->
                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavButton}" Tag="&#xE765;"
                                 Content="{l:T 'Sneltoetsen'}" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="&#xE946;"
                                 Content="{l:T 'Over'}" Checked="OnNavChecked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Overzicht ===== -->
        <ScrollViewer x:Name="OverviewPage" Grid.Column="1" Style="{StaticResource Page}" Visibility="Visible">
            <Grid Margin="36,30,36,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kop: naam en status links, verbinden rechts. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="2,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontSize="28" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Verbindingsstatus als "pil": groene stip als de audio met deze pc verbonden is. -->
                        <Border Background="{DynamicResource ButtonBackground}" CornerRadius="15" Padding="12,6"
                                VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource HighBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ConnectButtonText}"
                                IsEnabled="{Binding CanToggleConnection}" Click="OnConnectClick" />
                    </StackPanel>
                </Grid>

                <!-- Afbeelding links, drie tegels rechts. -->
                <Grid Grid.Row="1" Margin="0,26,0,0" Height="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Afbeelding op een zachte vlak in de accentkleur. -->
                    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                            Background="{DynamicResource AccentSubtleBrush}">
                        <Image Source="/PodPilot;component/Assets/case-open.png" Width="200" Height="200"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Components}" ItemTemplate="{StaticResource BigTile}"
                                  Margin="8,0,-8,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Nu aan het afspelen: hoes, titel, artiest en app. Verborgen als er niets is. -->
                <Border Grid.Row="2" DataContext="{Binding NowPlaying}" Style="{StaticResource Card}"
                        Margin="0,16,0,0" Padding="14,12"
                        Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Vorige, afspelen/pauzeren, volgende (E892/E893 = vorige/volgende). -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16"
                                    ToolTip="{l:T 'Vorige'}" Command="{Binding PreviousCommand}"
                                    IsEnabled="{Binding CanPrevious}" Margin="2,0" />
                            <Button Style="{StaticResource IconButton}" Content="{Binding PlayPauseGlyph}" FontSize="20"
                                    ToolTip="{Binding PlayPauseToolTip}" Command="{Binding PlayPauseCommand}"
                                    IsEnabled="{Binding CanPlayPause}" Margin="2,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16"
                                    ToolTip="{l:T 'Volgende'}" Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanNext}" Margin="2,0" />
                        </StackPanel>
                        <Grid Width="56" Height="56" VerticalAlignment="Center">
                            <Border CornerRadius="8" Background="{DynamicResource ButtonBackground}" />
                            <!-- E8D6 = muzieknoot, als de speler geen hoes geeft. -->
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource SymbolFont}" FontSize="22"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle RadiusX="8" RadiusY="8"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Snelle instellingen: dezelfde schakelaars als op het tabblad AirPods. -->
                <TextBlock Grid.Row="3" Text="{l:T 'Snelle instellingen'}" Style="{StaticResource SectionTitle}" Margin="2,24,0,0" />
                <UniformGrid Grid.Row="3" Rows="1" Margin="-6,52,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{l:T 'Case open'}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:T 'Automatisch verbinden'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickConnectLidToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Verbinden als de case opengaat'}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{l:T 'Oordop in'}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:T 'Automatisch verbinden'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickConnectEarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Verbinden als je ze indoet'}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{l:T 'Oordop uit'}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:T 'Media pauzeren'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="QuickPauseToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pauzeren als een oordop uitgaat'}" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <!-- ===== AirPods ===== -->
        <ScrollViewer x:Name="AirPodsPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{l:T 'AirPods'}" Style="{StaticResource PageTitle}" />

                <TextBlock Text="{l:T 'Automatisch verbinden'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Verbinden als de case opengaat'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Haalt de audio naar deze pc, ook als de AirPods met je telefoon verbonden waren.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectLidToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Verbinden als de case opengaat'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Verbinden als je ze indoet'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Zodra de eerste oordop in je oor gaat. Na zelf verbreken pas weer als de case dicht is geweest.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectEarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Verbinden als je ze indoet'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Oordetectie'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pauzeren als een oordop uitgaat'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Alleen als de AirPods met deze pc verbonden zijn.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPauseToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pauzeren als een oordop uitgaat'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="AutoResumeRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Hervatten als hij weer in gaat'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Binnen 5 minuten, en alleen wat PodPilot zelf heeft gepauzeerd.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoResumeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Hervatten als hij weer in gaat'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Media'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Afspelen na verbinden'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Start de speler die het laatst actief was zodra de AirPods verbonden zijn. Speelt er al iets, dan gebeurt er niets.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPlayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Afspelen na verbinden'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pauzeren na verbreken'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Pauzeert alles wat speelt zodra de AirPods loskomen, zodat de muziek niet uit de luidsprekers van de pc komt.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPauseOnDisconnectToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pauzeren na verbreken'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Geluid naar AirPods na verbinden'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Maakt de AirPods het standaard-afspeelapparaat van Windows zodra ze verbonden zijn.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="SwitchOutputToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Geluid naar AirPods na verbinden'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Welke gepairde AirPods gebruikt PodPilot?'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="DevicePanel" Margin="0,12,0,6" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Apparaten ===== -->
        <ScrollViewer x:Name="DevicesPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{l:T 'Apparaten'}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Margin="2,-12,0,18"
                           Text="{l:T 'Alle Bluetooth-koptelefoons, oordopjes en speakers die met deze pc gekoppeld zijn, ook van andere merken.'}" />

                <ItemsControl x:Name="DeviceList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- E7F6 = koptelefoon; groen als verbonden. -->
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ButtonBackground}"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="Glyph" Text="&#xE7F6;" FontFamily="{StaticResource SymbolFont}" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{l:T 'Deze AirPods gebruikt PodPilot voor de batterij en de pop-up'}"
                                                    Visibility="{Binding IsPodPilotDevice, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:T 'PodPilot'}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding BatteryText}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Button x:Name="ToggleButton" Grid.Column="2" Style="{StaticResource PillButton}" MinWidth="110"
                                            Content="{Binding ButtonText}" IsEnabled="{Binding CanToggle}"
                                            VerticalAlignment="Center" Click="OnDeviceToggleClick" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource HighBrush}" />
                                    <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="ToggleButton" Property="Foreground" Value="{DynamicResource AccentForeground}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoDevicesText" Style="{StaticResource RowHint}" Visibility="Collapsed"
                           Text="{l:T 'Er zijn geen gekoppelde Bluetooth-audioapparaten gevonden. Koppel ze eerst via de Bluetooth-instellingen van Windows.'}" />
                <Button Style="{StaticResource PillButton}" Content="{l:T 'Nieuw apparaat koppelen…'}" HorizontalAlignment="Left"
                        Margin="0,6,0,0" Click="OnBluetoothSettingsClick" />

                <!-- Pc als Bluetooth-speaker: geluid van de telefoon via deze pc. -->
                <TextBlock Text="{l:T 'Pc als speaker'}" Style="{StaticResource SectionTitle}" Margin="2,28,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,12">
                        <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,10"
                                   Text="{l:T 'Speel het geluid van je telefoon af via deze pc. Kies je telefoon en klik op Verbinden; de telefoon moet al via Bluetooth met de pc gekoppeld zijn.'}" />
                        <WrapPanel x:Name="StreamSourcePanel" />
                        <TextBlock x:Name="NoStreamSourcesText" Style="{StaticResource RowHint}" Visibility="Collapsed"
                                   Text="{l:T 'Geen telefoon gevonden. Koppel je telefoon via &quot;Nieuw apparaat koppelen…&quot; hierboven, en kom dan terug.'}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StreamStatusText" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T 'Niet verbonden'}" />
                            <Button x:Name="StreamButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="110"
                                    Content="{l:T 'Verbinden'}" Click="OnStreamClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Instellingen ===== -->
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{l:T 'Instellingen'}" Style="{StaticResource PageTitle}" />

                <!-- Profielen: elk profiel heeft eigen schakelaars voor verbinden, pauzeren en meldingen. -->
                <TextBlock Text="{l:T 'Profielen'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{l:T 'Actief profiel'}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Margin="0,2,0,8" TextWrapping="Wrap"
                                   Text="{l:T 'Wat je aanzet bij automatisch verbinden, pauzeren, afspelen, de pop-up en de batterijmelding, onthoudt PodPilot per profiel. Wisselen kan ook via het menu bij het systeemvak of een sneltoets.'}" />
                        <WrapPanel x:Name="ProfilePanel" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Algemeen'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Taal: wordt actief na herstarten. -->
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{l:T 'Taal'}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="LanguageHint" Text="{l:T 'Wordt actief nadat je PodPilot opnieuw start.'}"
                                       Style="{StaticResource RowHint}" Margin="0,2,0,8" />
                            <WrapPanel x:Name="LanguagePanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Starten met Windows'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'PodPilot start bij het aanmelden in het systeemvak.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Starten met Windows'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pop-up als de case opengaat'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Toont de batterijen als je de case naast de pc opent.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoPopupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pop-up als de case opengaat'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pop-up onthoudt zijn plek'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Aan: blijft staan waar je hem naartoe sleept. Uit: de volgende keer weer rechtsonder.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="RememberPopupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pop-up onthoudt zijn plek'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pop-up op het hoofdscherm'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Aan: altijd op het hoofdscherm. Uit: op het scherm waar je muis is.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="PopupMainScreenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Pop-up op het hoofdscherm'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Plek van de pop-up'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="PopupPositionHint" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <Button x:Name="ResetPopupPositionButton" Grid.Column="1" Style="{StaticResource PillButton}"
                                    Content="{l:T 'Terug naar rechtsonder'}" VerticalAlignment="Center"
                                    Click="OnResetPopupPositionClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Systeemvak-icoon'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Stijl'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                                <WrapPanel x:Name="TrayStylePanel" />
                            </StackPanel>
                            <!-- Voorbeeld op een lichte en een donkere taakbalk (85%): op echte grootte
                                 getekend en 2x vergroot met scherpe pixels. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        ToolTip="{l:T 'Voorbeeld bij 85%, zoals in de taakbalk (2x vergroot)'}">
                                <Border Width="44" Height="44" CornerRadius="8" Background="#F3F3F3" Margin="0,0,8,0">
                                    <Image x:Name="TrayPreviewLight" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <Border Width="44" Height="44" CornerRadius="8" Background="#202020">
                                    <Image x:Name="TrayPreviewDark" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel x:Name="TrayNumberSection" Margin="0,12">
                            <TextBlock Text="{l:T 'Lettertype'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="TrayFontPanel" Margin="0,0,0,10" />
                            <TextBlock Text="{l:T 'Grootte'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="TrayFontSizePanel" Margin="0,0,0,10" />
                            <TextBlock Text="{l:T 'Kleur bij een lichte taakbalk'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="TrayColorLightPanel" Margin="0,0,0,12" />
                            <TextBlock Text="{l:T 'Kleur bij een donkere taakbalk'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="TrayColorDarkPanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Doorzichtig als het geluid niet via de AirPods gaat'}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:T 'Zo zie je in één oogopslag dat het geluid bijvoorbeeld uit de laptopluidspreker komt.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="TrayDimToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Doorzichtig als het geluid niet via de AirPods gaat'}" />
                        </Grid>
                        <Grid x:Name="TrayDimRow" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T 'Zichtbaarheid'}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TrayDimValue" Grid.Column="1" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <Slider x:Name="TrayDimSlider" Grid.Column="2" Style="{StaticResource AccentSlider}"
                                    Minimum="10" Maximum="90" SmallChange="5" LargeChange="10" TickFrequency="5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:T 'Zichtbaarheid van het icoon'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Meldingen'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Melding bij lage batterij'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Eén melding per oordop zodra die op of onder de drempel komt.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="NotifyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Melding bij lage batterij'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel x:Name="ThresholdSection" Margin="0,12">
                            <TextBlock Text="{l:T 'Drempel'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="ThresholdPanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Melding als de case bijna leeg is'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Zelfde drempel als hierboven. De case is alleen te zien met een oordop erin en de deksel open.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="NotifyCaseLowToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Melding als de case bijna leeg is'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Melding als de case vol is'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Als de case tijdens het opladen op 100% komt.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="NotifyCaseFullToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Melding als de case vol is'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Melding als een oordop los ligt'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Als een oordop 10 minuten niet in je oor en niet in de case zit (dan laadt hij niet op).'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="NotifyLooseBudToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Melding als een oordop los ligt'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Thema'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="ThemeSection" Margin="0,12">
                            <TextBlock Text="{l:T 'Hoofdvenster'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="ThemePanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel x:Name="PopupThemeSection" Margin="0,12">
                            <TextBlock Text="{l:T 'Pop-up bij het systeemvak'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="PopupThemePanel" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <!-- Eigen achtergrondkleur (geldt voor hoofdvenster én pop-up). -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Eigen achtergrondkleur'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Voor het hoofdvenster en de pop-up. De kleur bepaalt ook of de tekst licht of donker is.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="CustomBackgroundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Eigen achtergrondkleur'}" />
                        </Grid>
                        <StackPanel x:Name="CustomBackgroundRow" Orientation="Horizontal" Margin="0,0,0,14">
                            <WrapPanel x:Name="BackgroundSwatches" VerticalAlignment="Center" />
                            <TextBox x:Name="BackgroundHex" Style="{StaticResource HexBox}" Margin="6,0,0,0"
                                     AutomationProperties.Name="{l:T 'Achtergrondkleur als hexcode'}" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <!-- Eigen accentkleur. -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Eigen accentkleur'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Voor schakelaars, knoppen en het actieve tabblad, in plaats van de accentkleur van Windows.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="CustomAccentToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Eigen accentkleur'}" />
                        </Grid>
                        <StackPanel x:Name="CustomAccentRow" Orientation="Horizontal" Margin="0,0,0,14">
                            <WrapPanel x:Name="AccentSwatches" VerticalAlignment="Center" />
                            <TextBox x:Name="AccentHex" Style="{StaticResource HexBox}" Margin="6,0,0,0"
                                     AutomationProperties.Name="{l:T 'Accentkleur als hexcode'}" />
                        </StackPanel>
                        <TextBlock x:Name="ColorHint" Style="{StaticResource RowHint}" Margin="0,-6,0,12"
                                   Foreground="{DynamicResource LowBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Overig'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T 'Instellingen exporteren en importeren'}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="ExportHint" Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                       Text="{l:T 'Bewaar al je instellingen in een bestand, en zet ze terug op deze of een andere pc.'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillButton}" Content="{l:T 'Exporteren'}" Click="OnExportClick" />
                            <Button Style="{StaticResource PillButton}" Content="{l:T 'Importeren'}" Click="OnImportClick"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T 'Standaardinstellingen'}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="ResetHint" Style="{StaticResource RowHint}"
                                       Text="{l:T 'Zet alle instellingen terug zoals na een nieuwe installatie. &quot;Starten met Windows&quot; blijft zoals het is.'}" />
                        </StackPanel>
                        <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource PillButton}"
                                Content="{l:T 'Terugzetten'}" VerticalAlignment="Center" Click="OnResetClick" />
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Sneltoetsen ===== -->
        <ScrollViewer x:Name="HotkeysPage" Grid.Column="1" Style="{StaticResource Page}">
            <StackPanel Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{l:T 'Sneltoetsen'}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Margin="2,-12,0,18"
                           Text="{l:T 'Werken overal in Windows, ook als PodPilot niet op de voorgrond staat. Klik op een combinatie en druk een nieuwe; Esc = annuleren.'}" />

                <TextBlock Text="{l:T 'Pop-up'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Pop-up tonen of verbergen'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Opent of sluit de pop-up.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="HotkeyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor de pop-up'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="HotkeyRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Toetscombinatie'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Klik op de knop en druk een nieuwe combinatie.'}" />
                            </StackPanel>
                            <Button x:Name="HotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Toetscombinatie voor de pop-up'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'AirPods'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Verbinden / verbreken'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Verbindt de AirPods met deze pc, of verbreekt de verbinding als ze al verbonden zijn.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="ConnectHotkeyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor verbinden en verbreken'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="ConnectHotkeyRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Toetscombinatie'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="ConnectHotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Klik op de knop en druk een nieuwe combinatie.'}" />
                            </StackPanel>
                            <Button x:Name="ConnectHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Toetscombinatie voor verbinden en verbreken'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Geluid'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Geluidsuitgang wisselen'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Elke druk gaat naar de volgende geluidsuitgang (AirPods, luidsprekers, ...). Onderin het scherm zie je even welke.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="OutputHotkeyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor geluidsuitgang wisselen'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid x:Name="OutputHotkeyRow" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Toetscombinatie'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="OutputHotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Klik op de knop en druk een nieuwe combinatie.'}" />
                            </StackPanel>
                            <Button x:Name="OutputHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Toetscombinatie voor geluidsuitgang wisselen'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Media en profielen: één regel per sneltoets (tekst, combinatie, schakelaar). -->
                <TextBlock Text="{l:T 'Media'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Afspelen/pauzeren'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="PlayPauseHotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Voor de speler die bij Nu aan het afspelen staat.'}" />
                            </StackPanel>
                            <Button x:Name="PlayPauseHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    AutomationProperties.Name="{l:T 'Toetscombinatie voor afspelen/pauzeren'}" />
                            <CheckBox x:Name="PlayPauseHotkeyToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor afspelen/pauzeren'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Volgende'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="NextHotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Volgend nummer.'}" />
                            </StackPanel>
                            <Button x:Name="NextHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    AutomationProperties.Name="{l:T 'Toetscombinatie voor volgende'}" />
                            <CheckBox x:Name="NextHotkeyToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor volgende'}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Vorige'}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="PreviousHotkeyHint" Style="{StaticResource RowHint}"
                                           Text="{l:T 'Vorig nummer.'}" />
                            </StackPanel>
                            <Button x:Name="PreviousHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    AutomationProperties.Name="{l:T 'Toetscombinatie voor vorige'}" />
                            <CheckBox x:Name="PreviousHotkeyToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Sneltoets voor vorige'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T 'Profielen'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T 'Profiel wisselen'}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="ProfileHotkeyHint" Style="{StaticResource RowHint}"
                                       Text="{l:T 'Wisselt tussen Werk en Thuis (zie Instellingen › Profielen).'}" />
                        </StackPanel>
                        <Button x:Name="ProfileHotkeyButton" Grid.Column="1" Style="{StaticResource PillButton}" MinWidth="120"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                AutomationProperties.Name="{l:T 'Toetscombinatie voor profiel wisselen'}" />
                        <CheckBox x:Name="ProfileHotkeyToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="{l:T 'Sneltoets voor profiel wisselen'}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Over ===== -->
        <ScrollViewer x:Name="AboutPage" Grid.Column="1" Style="{StaticResource Page}">
            <!-- Verdwijnt als de verborgen achtergrond aangaat, zodat je alleen de foto ziet. -->
            <StackPanel x:Name="AboutContent" Margin="36,30,36,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{l:T 'Over PodPilot'}" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource BudsInCaseIllustration}" Width="72" Height="66" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="{l:T 'PodPilot'}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowHint}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,0"
                                       Text="{l:T 'Toont de batterij van je AirPods en regelt de verbinding met deze pc. Geen account: alles blijft op deze computer. Alleen voor het zoeken naar updates vraagt PodPilot bij GitHub de nieuwste versie op.'}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource PillButton}" Content="{l:T 'Diagnoselog openen'}" Margin="0,0,8,8"
                                        Click="OnOpenLogClick" />
                                <Button Style="{StaticResource PillButton}" Content="{l:T 'Map met instellingen'}" Margin="0,0,8,8"
                                        Click="OnOpenSettingsFolderClick" />
                                <Button Style="{StaticResource PillButton}" Content="{l:T 'Bluetooth-instellingen'}" Margin="0,0,8,8"
                                        Click="OnBluetoothSettingsClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{l:T 'Updates'}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowTitle}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T 'Nog niet gezocht.'}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CheckUpdatesButton" Style="{StaticResource PillButton}" Content="{l:T 'Nu controleren'}"
                                        Click="OnCheckUpdatesClick" />
                                <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Content="{l:T 'Bijwerken'}"
                                        MinWidth="0" Margin="8,0,0,0" Visibility="Collapsed" Click="OnInstallUpdateClick" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'Bij het opstarten naar updates zoeken'}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T 'Is er een nieuwe versie, dan krijg je één melding. Bijwerken installeert hem en start PodPilot opnieuw.'}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="CheckUpdatesToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="{l:T 'Bij het opstarten naar updates zoeken'}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
