<!--
    Pop-up rechtsonder (boven het systeemvak). Zonder titelbalk en met afgeronde hoeken.
    Hij verdwijnt zodra je ergens anders klikt. Slepen aan de achtergrond verplaatst hem (de plek
    wordt onthouden; Instellingen › "Terug naar rechtsonder" zet hem terug).
-->
<Window x:Class="PodPilot.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PodPilot.App.Services"
        xmlns:vm="clr-namespace:PodPilot.App.ViewModels"
        Title="{l:T 'PodPilot'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing"
        MouseLeftButtonDown="OnBackgroundMouseDown">

    <Window.Resources>
        <!-- Weergave van één onderdeel: icoon, naam, percentage en batterijbalk. -->
        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel Width="108" ToolTip="{Binding ToolTipText}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Width="60" Height="60" HorizontalAlignment="Center">
                    <Path x:Name="Icon" Data="{StaticResource BudGeometry}" Fill="{DynamicResource IconFill}"
                          Stretch="Uniform" Margin="4" RenderTransformOrigin="0.5,0.5" />
                    <!-- Blauwe stip: oordop zit in het oor. -->
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                            Visibility="{Binding IsInEar, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <TextBlock Text="{Binding DisplayLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />

                <StackPanel x:Name="PercentRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,7">
                    <Path Data="{StaticResource BoltGeometry}" Fill="{DynamicResource AccentBrush}"
                          Stretch="Uniform" Height="15" Margin="0,0,5,0" VerticalAlignment="Center"
                          Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding PercentText}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <ProgressBar x:Name="Bar" Style="{StaticResource BatteryBar}" Width="68" Value="{Binding Value, Mode=OneWay}" />

                <!-- Schatting uit de batterijgeschiedenis; alleen als de oordop in het oor zit. -->
                <TextBlock Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           ToolTip="{l:T 'Schatting op basis van je eerdere luistersessies'}"
                           Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <DataTemplate.Triggers>
                <!-- Icoon per soort onderdeel. -->
                <!-- De tekening heeft het steeltje rechts; de linker oordop wordt gespiegeld. -->
                <DataTrigger Binding="{Binding Kind}" Value="LeftBud">
                    <Setter TargetName="Icon" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="-1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Case">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource CaseGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Headphones">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource HeadphonesGeometry}" />
                </DataTrigger>

                <!-- Kleur van de balk naar batterijniveau. -->
                <DataTrigger Binding="{Binding Level}" Value="Medium">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource MediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Low">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource LowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Unknown">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                </DataTrigger>

                <!-- Laatst bekende waarde (bijv. lege case): gedimd. -->
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="PercentRow" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- De marge geeft de schaduw ruimte en houdt afstand tot de taakbalk. -->
    <Grid Margin="16" Width="380">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <!-- Aparte laag voor de schaduw, zodat de tekst niet wazig wordt door het effect. -->
        <Border CornerRadius="12" Background="{DynamicResource WindowBackground}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" Padding="18,14,18,16">
            <StackPanel>
                <!-- Kop: naam, model en status. -->
                <Grid>
                    <StackPanel Margin="2,0,40,0">
                        <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:T 'Sluiten'}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick" />
                </Grid>

                <!-- Links, rechts en case. -->
                <ItemsControl ItemsSource="{Binding Components}" Margin="0,16,0,18" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Onderbalk: verbindingsstatus links, knoppen rechts. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Grid in plaats van een StackPanel: dan krijgt de tekst de vrije breedte en loopt
                         hij door op een tweede regel in plaats van afgekapt te worden. -->
                    <Grid VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="{Binding ConnectionText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource HighBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" FontSize="12" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- E713 = tandwiel, E702 = Bluetooth-symbool -->
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="15"
                                ToolTip="{l:T 'Instellingen'}" Click="OnSettingsClick" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE702;" FontSize="15"
                                ToolTip="{l:T 'Bluetooth-instellingen openen'}" Click="OnBluetoothSettingsClick" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ConnectButtonText}"
                                IsEnabled="{Binding CanToggleConnection}" Margin="6,0,0,0" Click="OnConnectClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
