<!--
    Eigen vectoricoontjes (geen afbeeldingen van Apple). Elk icoon past in een vlak van 48x48;
    de Path in de UI schaalt het met Stretch="Uniform".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Oordop: een ronde kop met een steeltje. De linker oordop is gespiegeld (ScaleX=-1). -->
    <CombinedGeometry x:Key="BudGeometry" GeometryCombineMode="Union">
        <CombinedGeometry.Geometry1>
            <EllipseGeometry Center="19,15" RadiusX="12" RadiusY="12" />
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
            <RectangleGeometry Rect="23,17,9,29" RadiusX="4.5" RadiusY="4.5" />
        </CombinedGeometry.Geometry2>
    </CombinedGeometry>

    <!-- Oplaadcase: afgeronde doos. Een dunne naad (deksel) en een lampje zijn uitgespaard (EvenOdd). -->
    <GeometryGroup x:Key="CaseGeometry" FillRule="EvenOdd">
        <RectangleGeometry Rect="2,9,44,32" RadiusX="12" RadiusY="12" />
        <RectangleGeometry Rect="2,19,44,1.6" />
        <EllipseGeometry Center="24,30" RadiusX="1.8" RadiusY="1.8" />
    </GeometryGroup>

    <!-- Over-ear-koptelefoon (AirPods Max): beugel en twee oorschelpen. -->
    <GeometryGroup x:Key="HeadphonesGeometry" FillRule="Nonzero">
        <PathGeometry Figures="M 6,27 A 18,18 0 0 1 42,27 L 38,27 A 14,14 0 0 0 10,27 Z" />
        <RectangleGeometry Rect="3,24,11,20" RadiusX="5" RadiusY="5" />
        <RectangleGeometry Rect="34,24,11,20" RadiusX="5" RadiusY="5" />
    </GeometryGroup>

    <!--
        Kleur-illustratie voor de apparaatkaart: een open oplaadcase met twee oordopjes erin.
        Eigen tekening (vlak van 120x110), geen productfoto en geen logo. De kleuren zijn vast
        (witte behuizing), dus hij werkt op een licht en een donker thema.
    -->
    <DrawingImage x:Key="BudsInCaseIllustration">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Onzichtbaar kader zodat de afmeting vastligt. -->
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 120 V 110 H 0 Z" />

                <!-- Zachte schaduw onder de case. -->
                <GeometryDrawing Geometry="M 22,101 A 38,6 0 1 0 98,101 A 38,6 0 1 0 22,101 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#40000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- Deksel, open naar achteren gekanteld. -->
                <GeometryDrawing Geometry="M 24,40 C 24,18 34,10 60,10 C 86,10 96,18 96,40 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#E4E7EC" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C9CED6" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Binnenkant van het deksel. -->
                <GeometryDrawing Brush="#D5D9DF" Geometry="M 30,40 C 30,24 38,17 60,17 C 82,17 90,24 90,40 Z" />

                <!-- Opening van de case (donkere binnenkant). -->
                <GeometryDrawing Geometry="M 22,44 C 22,40 24,39 28,39 H 92 C 96,39 98,40 98,44 V 48 H 22 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#9BA2AD" Offset="0" />
                            <GradientStop Color="#C3C8D0" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- Twee oordopjes: alleen de koppen steken boven de case uit. -->
                <GeometryDrawing Geometry="M 46,44 m -11,0 a 11,10 0 1 0 22,0 a 11,10 0 1 0 -22,0">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.4,0.35" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#DCE0E6" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#BEC4CC" Thickness="0.8" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 74,44 m -11,0 a 11,10 0 1 0 22,0 a 11,10 0 1 0 -22,0">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.4,0.35" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#DCE0E6" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#BEC4CC" Thickness="0.8" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Roostertjes van de speakers. -->
                <GeometryDrawing Brush="#4A4F57" Geometry="M 43,40 m -4,0 a 4,2.4 0 1 0 8,0 a 4,2.4 0 1 0 -8,0" />
                <GeometryDrawing Brush="#4A4F57" Geometry="M 77,40 m -4,0 a 4,2.4 0 1 0 8,0 a 4,2.4 0 1 0 -8,0" />

                <!-- Onderkant van de case: afgeronde doos. -->
                <GeometryDrawing Geometry="M 22,48 H 98 V 82 C 98,96 90,100 76,100 H 44 C 30,100 22,96 22,82 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F1F3F6" Offset="0.55" />
                            <GradientStop Color="#D7DBE1" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C3C8D0" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Glans langs de linkerkant. -->
                <GeometryDrawing Brush="#80FFFFFF" Geometry="M 27,52 H 33 V 84 C 33,90 31,92 29,90 C 27,88 27,86 27,82 Z" />
                <!-- Statuslampje. -->
                <GeometryDrawing Brush="#7CD992" Geometry="M 60,64 m -2.2,0 a 2.2,2.2 0 1 0 4.4,0 a 2.2,2.2 0 1 0 -4.4,0" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bliksemschicht voor "aan het opladen". -->
    <PathGeometry x:Key="BoltGeometry" Figures="M 7,0 L 0,10 L 5,10 L 4,16 L 11,6 L 6,6 Z" />

</ResourceDictionary>
