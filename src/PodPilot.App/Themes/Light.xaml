<!-- Kleuren voor het lichte thema. Dark.xaml gebruikt dezelfde sleutels. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#F9F9FB" />
    <SolidColorBrush x:Key="PageBackground" Color="#F0F1F4" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E6E8EB" />
    <SolidColorBrush x:Key="WindowBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1C1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F646B" />
    <SolidColorBrush x:Key="IconFill" Color="#C3C8D0" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E2E4E8" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#ECEEF1" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E0E3E7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7DF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F6AE0" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F2F7DF6" />
    <SolidColorBrush x:Key="NavBackground" Color="#E9EBEF" />
    <SolidColorBrush x:Key="HighBrush" Color="#2EAD5B" />
    <SolidColorBrush x:Key="MediumBrush" Color="#D99A00" />
    <SolidColorBrush x:Key="LowBrush" Color="#E5484D" />
</ResourceDictionary>
